package main

import "github.com/Tend-Stack/GothUI/v2026/components"

templ motionStudio(a components.Appearance, mode string) {
	@demoHeader("/motion")
	<main id="main">
		@components.Breadcrumbs(components.BreadcrumbsProps{Items: []components.BreadcrumbItem{{Label: "GothUI", Href: "/"}, {Label: "Motion & surfaces"}}})
		<section>
			<p class="muted">A LITTLE LIFE, BUILT IN</p>
			<h1>Quietly expressive.</h1>
			<p>Soft entrances, tactile surfaces, and useful states. Everything here is HTML and CSS, served from the same Go binary.</p>
			@components.Form(components.FormProps{Action: "/motion", Method: components.MethodGet}) {
				@components.Grid(components.GridProps{}) {
					@components.Select(components.SelectProps{Name: "motion", Label: "Motion", Value: string(a.Motion), Options: []components.Option{{Label: "Follow system preference", Value: "system"}, {Label: "Off", Value: "off"}}})
					@components.Select(components.SelectProps{Name: "theme", Label: "Color mode", Value: mode, Options: []components.Option{{Label: "Light", Value: "light"}, {Label: "Dark", Value: "dark"}, {Label: "System", Value: "system"}}})
					@components.Select(components.SelectProps{Name: "preset", Label: "Color preset", Value: string(a.Preset), Options: []components.Option{{Label: "Indigo", Value: "indigo"}, {Label: "Forest", Value: "forest"}, {Label: "Rose", Value: "rose"}, {Label: "Neutral", Value: "neutral"}}})
				}
				@components.Button(components.ButtonProps{Text: "Apply & replay entrances", Type: components.ButtonTypeSubmit})
			}
			<p><small>Entrances run when the page loads. Follow system always respects your device’s reduced-motion setting. Save a global preference on the <a href="/settings">Appearance page</a>.</small></p>
		</section>
		<section aria-labelledby="surface-heading">
			<h2 id="surface-heading">Surfaces with character.</h2>
			@components.Grid(components.GridProps{}) {
				@components.Card(components.CardProps{Surface: components.SurfaceGradient, Entry: components.EntryRise, HoverLift: true, Header: cardHeading("A fine edge")}) {
					@components.Badge(components.BadgeProps{Text: "Gradient border", Tone: components.ToneInfo})
					<p>A quiet accent around an opaque surface. Hover or focus the link for a slight lift.</p>
					<a href="/workspace">Explore the workspace →</a>
				}
				@components.Card(components.CardProps{Surface: components.SurfaceTinted, Entry: components.EntryFade, Delay: components.DelayShort, Header: cardHeading("A softer canvas")}) {
					@components.Stat(components.StatProps{Label: "Sample tasks complete", Value: "24", Detail: "A metric with room to breathe."})
				}
				@components.Card(components.CardProps{Surface: components.SurfaceOutlined, Entry: components.EntryScale, Delay: components.DelayMedium, Header: cardHeading("A clear outline")}) {
					<p>Defined by color and space. No shadow required. Each surface follows your chosen theme.</p>
					@components.Link(components.LinkProps{Text: "Personalize your theme", Href: "/settings", Outline: true})
				}
			}
		</section>
		<section aria-labelledby="state-heading">
			<h2 id="state-heading">Every state deserves care.</h2>
			@components.Grid(components.GridProps{}) {
				@components.Card(components.CardProps{Header: cardHeading("While something loads")}) {
					@components.Skeleton(components.SkeletonProps{Label: "Preview placeholder — no request is running", Avatar: true, Lines: 3})
					<p><small>The decoration settles after three gentle cycles. The label stays readable throughout.</small></p>
				}
				@components.EmptyState(components.EmptyStateProps{Title: "Room for your next idea", Message: "Empty states can explain what belongs here and offer a useful next step."}) {
					@components.Link(components.LinkProps{Text: "Browse sample projects", Href: "/dashboard"})
				}
			}
		</section>
		<section aria-labelledby="overlay-motion-heading">
			<h2 id="overlay-motion-heading">Open with a little ease.</h2>
			<div class="cluster">
				@components.Button(components.ButtonProps{Text: "Open a dialog", CommandFor: "motion-dialog", Command: components.DialogShowModal})
				@components.Button(components.ButtonProps{Text: "Show a popover", PopoverTarget: "motion-popover", Outline: true})
				<a href="/interactions?view=confirm">Ordinary-page confirmation →</a>
			</div>
			<p>These panels enter once per opening and close immediately. Switch motion off to compare. Native opener support depends on your browser.</p>
		</section>
		<details>
			<summary>Try the motion checks</summary>
			<ol><li>Apply a theme and watch the three card entrances.</li><li>Turn motion off, replay, and check that content is immediately visible.</li><li>Enable reduced motion in your operating system. Follow system should remain still.</li><li>Tab to the gradient card’s link. Its focus ring must remain visible.</li><li>Open and close both panels, then test at a narrow phone width.</li></ol>
		</details>
	</main>
	@components.Dialog(components.DialogProps{ID: "motion-dialog", Title: "A gentle entrance", Description: "A short rise and fade, with native focus and keyboard behavior."}) {
		<p>All content remains available with motion disabled. Escape or Close dismisses this dialog.</p>
	}
	@components.Popover(components.PopoverProps{ID: "motion-popover", Title: "A small detail"}) {
		<p>A subtle scale gives the panel a sense of arrival. Click outside or press Escape to dismiss it.</p>
	}
	@demoFooter()
}
