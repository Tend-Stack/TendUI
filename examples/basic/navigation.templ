package main

import "github.com/Tend-Stack/GothUI/v2026/components"

templ demoHeader(active string) {
	<header>
		<a href="#main">Skip to content</a>
		<nav aria-label="Demo pages">
			<a href="/" aria-label="GothUI home"><strong>◈ GothUI</strong></a>
			<ul>
				for _, page := range []struct{ Path, Label string }{{"/", "Overview"}, {"/playground", "Playground"}, {"/forms", "Form lab"}, {"/dashboard", "Dashboard"}, {"/settings", "Appearance"}, {"/workspace", "Workspace"}, {"/interactions", "Interactions"}, {"/editing", "Inline editing"}} {
					<li>
						<a
							href={ templ.URL(page.Path) }
							if active == page.Path {
								aria-current="page"
							}
						>{ page.Label }</a>
					</li>
				}
				<li>@components.ThemeToggle()</li>
			</ul>
		</nav>
	</header>
}

templ demoFooter() {
	<footer><small>GothUI { version } · Native HTML and CSS. No JavaScript required.</small></footer>
}

templ demoDirectory() {
	<section aria-labelledby="demos-title">
		<h2 id="demos-title">Take it for a spin.</h2>
		@components.Grid(components.GridProps{}) {
			@components.Card(components.CardProps{Header: cardHeading("01 / Component playground")}) {
				<p>Change themes, button variants, input states, and card slots. Inspect every combination.</p>
				<a href="/playground">Open the playground →</a>
			}
			@components.Card(components.CardProps{Header: cardHeading("02 / Form lab")}) {
				<p>Exercise browser validation, server errors, reset behavior, and a successful submission.</p>
				<a href="/forms">Test a form →</a>
			}
			@components.Card(components.CardProps{Header: cardHeading("03 / Project dashboard")}) {
				<p>See cards, metrics, filters, tables, and progress indicators in a practical layout.</p>
				<a href="/dashboard">Explore the dashboard →</a>
			}
		}
	</section>
}
