package main

import "strconv"
import "github.com/Tend-Stack/GothUI/v2026/components"

templ dashboard(d dashboardOptions) {
	@demoHeader("/dashboard")
	<main id="main">
		<section>
			<p class="muted">A SMALL STUDIO / DEMO WORKSPACE</p>
			<h1>A clearer view of your work.</h1>
			<p>A sample dashboard built from the same semantic components. Search and filter the sample projects below.</p>
		</section>
		<section aria-label="Sample portfolio totals">
			@components.Grid(components.GridProps{}) {
				@components.Card(components.CardProps{Header: cardHeading("Active projects"), Footer: cardNote("Across the sample portfolio")}) {
					<h2>02</h2>
					<p>Moving forward this week.</p>
				}
				@components.Card(components.CardProps{Header: cardHeading("Completed"), Footer: cardNote("Across the sample portfolio")}) {
					<h2>02</h2>
					<p>Ready for the next chapter.</p>
				}
				@components.Card(components.CardProps{Header: cardHeading("On hold"), Footer: cardNote("Across the sample portfolio")}) {
					<h2>01</h2>
					<p>Waiting for a little attention.</p>
				}
			}
		</section>
		<section aria-labelledby="projects-heading">
			<h2 id="projects-heading">Projects</h2>
			@components.Form(components.FormProps{Action: "/dashboard", Method: components.MethodGet}) {
				@components.Grid(components.GridProps{}) {
					@components.Input(components.InputProps{Name: "q", Label: "Search projects", Type: components.InputSearch, Value: d.Search, Placeholder: "Try design or portal"})
					@components.Select(components.SelectProps{Name: "status", Label: "Status", Value: d.Status, Options: []components.Option{{Label: "All projects", Value: "all"}, {Label: "Active", Value: "active"}, {Label: "Complete", Value: "complete"}, {Label: "On hold", Value: "paused"}}})
				}
				<div class="cluster">@components.Button(components.ButtonProps{Text: "Filter projects", Type: components.ButtonTypeSubmit}) <a href="/dashboard">Clear filters</a></div>
			}
			@components.Card(components.CardProps{}) {
				<p role="status">{ strconv.Itoa(len(d.Projects)) } projects match your filters.</p>
				if len(d.Projects) == 0 {
					<h3>No matching projects.</h3>
					<p>Try “design,” switch the status, or clear your filters.</p><a href="/dashboard">Show all projects</a>
				} else {
					<div class="table-scroll" tabindex="0" role="region" aria-label="Scrollable projects table">
						<table>
							<caption>Sample project portfolio</caption>
							<thead><tr><th scope="col">Project</th><th scope="col">Discipline</th><th scope="col">Status</th><th scope="col">Due</th><th scope="col">Progress</th></tr></thead>
							<tbody>
								for _, p := range d.Projects {
									<tr><th scope="row">{ p.Name }</th><td>{ p.Category }</td><td>{ p.Status }</td><td>{ p.Due }</td><td><progress aria-label={ p.Name + " progress" } value={ p.Progress } max="100">{ p.Progress }%</progress><small>{ p.Progress }%</small></td></tr>
								}
							</tbody>
						</table>
					</div>
				}
			}
		</section>
		<section aria-labelledby="dashboard-test-heading">
			<h2 id="dashboard-test-heading">Explore the details.</h2>
			@components.Grid(components.GridProps{}) {
				@components.Card(components.CardProps{Header: cardHeading("Make room for small screens")}) {
					<p>Narrow your browser to a phone-sized window. Cards stack and the table remains scrollable without stretching the page.</p>
					@components.Link(components.LinkProps{Text: "Try component states", Href: "/playground", Outline: true})
				}
				@components.Card(components.CardProps{Header: cardHeading("Test an empty result")}) {
					<p>Search for something that does not exist. A useful empty state should appear with a way back.</p>
					<a href="/dashboard?q=no-matching-project">Show the empty state →</a>
				}
			}
		</section>
	</main>
	@demoFooter()
}
